{
  "name": "charity-events-api",
  "version": "2.0.0",
  "private": true,
  "description": "PROG2002 Assessment 3 - RESTful API for the charity events website (Node.js + Express + MySQL), written in TypeScript and compiled to dist/, with the full C.R.U.D. cycle for events and event registrations",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-views.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node ../tests/run-tests.js"
  },
  "keywords": [
    "prog2002",
    "express",
    "mysql",
    "rest-api",
    "charity-events"
  ],
  "author": "LiuXu (xliu67)",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.3",
    "typescript": "~6.0.2"
  }
}
