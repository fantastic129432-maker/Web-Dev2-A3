# ---------------------------------------------------------------------------
# api/.env.example
# Copy this file to api/.env and adjust the values for your computer.
# api/.env is never committed to GitHub (see .gitignore).
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

# Port the Express API listens on
PORT=3000

# ---------------------------------------------------------------------------
# Data source
#   mysql (default, submitted configuration) -> reads from the MySQL database
#   local                                    -> reads the offline mirror of
#                                               database/02_seed.sql, for a
#                                               computer without MySQL
# ---------------------------------------------------------------------------
DATA_SOURCE=mysql

# ---------------------------------------------------------------------------
# MySQL connection (used when DATA_SOURCE=mysql)
# Run database/charityevents_db.sql first (tools/load-database.mjs does it for
# you), then set the account details below.
#
# Assessment 2 only read, so a SELECT-only account was enough. Assessment 3
# implements the full C.R.U.D. cycle, so the account also needs INSERT, UPDATE
# and DELETE - without them every create, update and delete fails with MySQL
# error 1142 ("command denied"), which the API reports as a 500.
#
# The account is still least-privilege: it can touch this one database and
# nothing else, and it cannot create or drop tables, so the schema stays under
# the administrator's control. Create it once with:
#
#   CREATE USER 'charity_app'@'127.0.0.1' IDENTIFIED BY 'your_password_here';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON charityevents_db.* TO 'charity_app'@'127.0.0.1';
#
# Use 127.0.0.1 rather than localhost so the driver always connects over TCP
# instead of a named pipe. Note that 'charity_app'@'localhost' and
# 'charity_app'@'127.0.0.1' are DIFFERENT accounts in MySQL, so the host in the
# GRANT must match the DB_HOST below.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=charity_app
DB_PASSWORD=your_password_here
DB_NAME=charityevents_db
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------------
# CORS - which page origins may call the API.
# The client website runs on port 5500. Use * only for local marking.
#
# This is a template, so the deployed origin stays a placeholder: whoever
# copies this file to api/.env has to put THEIR host here. A real domain must
# not be baked in, or a marker who copies the file inherits someone else's
# origin and every request is blocked by the browser.
# ---------------------------------------------------------------------------
CORS_ORIGIN=https://<你的cPanel域名>,http://localhost:5500,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# Rate limiting (per client IP). Set RATE_LIMIT_MAX=0 to switch it off.
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# Pagination defaults for /api/events
# ---------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Optional: fixes "today" for the offline demo, e.g. 2026-09-28.
# Leave empty to use the real current date (matches CURDATE() in MySQL).
# ---------------------------------------------------------------------------
# DEMO_TODAY=2026-09-28
